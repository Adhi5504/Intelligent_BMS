{
  "name": "pumprupee-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PumpRupee audit dashboard (simulated data) - Schneider Electric Yuva Yodha 2026, Team ANS_4X",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "npm run build && npm run preview",
    "typecheck": "tsc -b --noEmit",
    "gen-data": "python3 scripts/gen_data.py",
    "tunnel:cloudflare": "cloudflared tunnel --url http://localhost:4173",
    "tunnel:ngrok": "ngrok http 4173"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
